# ==========================================================
# Mishika Fashion Boutique - Automated Email Settings (.env)
# ==========================================================
# To enable fully automated background sending using Gmail:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate a 16-character Google App Password:
#    https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other" -> name it "Shivi Agent")
# 3. Enter your Gmail address and the 16-character App Password below.
# ==========================================================

# SMTP Host & Port (Default is Gmail TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail Account Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password

# Sender Details
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Mishika Fashion Boutique Concierge

# Admin Notification Email (where Morning/Evening PDF Audits are sent)
ADMIN_EMAIL=your-email@gmail.com

# Automation Flags
AUTO_SEND_ADMIN_AUDITS=true
AUTO_SEND_CUSTOMER_EMAILS=true

# ==========================================================
# Google AI Studio (Gemini) Intelligence Settings
# ==========================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
AI_PROVIDER=auto
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
